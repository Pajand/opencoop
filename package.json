{
  "name": "@opencoop/opencode-plugin",
  "version": "1.10.1",
  "description": "OpenCode plugin for team collaboration via shared file system",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opencoop": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --skipLibCheck && cp -r src/web/public dist/web/",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "mcp",
    "opencode",
    "plugin",
    "collaboration",
    "shared",
    "team"
  ],
  "author": "Hamid Pajand",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.20",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.0",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "sql.js": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9",
    "uuid": "^11.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "dotenv": "^16.4.7",
    "chalk": "^5.4.1",
    "diff": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/uuid": "^10.0.0",
    "@types/diff": "^6.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  }
}
